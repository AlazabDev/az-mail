{
  "name": "@plunk/mcp",
  "version": "0.14.0",
  "description": "Official Model Context Protocol server for Plunk — send email, manage contacts, campaigns and segments from an AI agent",
  "license": "AGPL-3.0-only",
  "type": "module",
  "mcpName": "com.useplunk/plunk",
  "bin": {
    "plunk-mcp": "./dist/index.js",
    "az-mail-mcp-http": "./dist/http.js"
  },
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./stdio": "./dist/index.js",
    "./http": "./dist/http.js"
  },
  "files": [
    "dist",
    "README.md",
    "AGENT_MAIL.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/useplunk/plunk.git",
    "directory": "apps/mcp"
  },
  "homepage": "https://docs.useplunk.com",
  "keywords": [
    "plunk",
    "mcp",
    "modelcontextprotocol",
    "email",
    "transactional-email"
  ],
  "scripts": {
    "build": "tsc",
    "serve:agent-http": "node dist/http.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "lint": "eslint .",
    "clean": "rimraf node_modules dist .turbo"
  },
  "//scripts": "No root dev/start script: stdio MCP is spawned by the client. Use serve:agent-http for the authenticated Alazab Microsoft Foundry remote MCP endpoint.",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@plunk/typescript-config": "*",
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}

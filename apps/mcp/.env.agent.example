# az-mail API project used by the agent MCP gateway
PLUNK_MCP_API_URL=https://api.mail.alazab.com
PLUNK_MCP_API_KEY=sk_replace_with_agent_mail_project_secret_key

# Fixed mailbox domain. Verify this domain in az-mail before sending.
AZ_MAIL_AGENT_DOMAIN=agents.alazab.com

# Remote MCP listener. Keep loopback when Nginx terminates TLS.
AZ_MAIL_MCP_HOST=127.0.0.1
AZ_MAIL_MCP_PORT=8787
# Required only when binding MCP directly to a non-loopback address.
AZ_MAIL_MCP_ALLOWED_HOSTS=mail.alazab.com

# One unique bearer token per Microsoft Foundry agent.
# Generate cryptographically random values of at least 32 characters.
AZ_MAIL_AGENT_TOKENS_JSON={"az-agent-backend":"replace-backend-token","az-agent-azabot":"replace-azabot-token","az-agent-auth":"replace-auth-token","az-agent-prod":"replace-prod-token","az-agent-maint":"replace-maint-token","az-agent-core":"replace-core-token","az-agent-bim":"replace-bim-token","az-agent-finance":"replace-finance-token","az-agent-payments":"replace-payments-token","az-agent-copilot":"replace-copilot-token","az-agent-project":"replace-project-token","az-agent-vision":"replace-vision-token"}

# Optional JSON overrides. Omit to use the defaults below:
# backend@agents.alazab.com, azabot@agents.alazab.com, auth@agents.alazab.com,
# prod@agents.alazab.com, maint@agents.alazab.com, core@agents.alazab.com,
# bim@agents.alazab.com, finance@agents.alazab.com, payments@agents.alazab.com,
# copilot@agents.alazab.com, project@agents.alazab.com, vision@agents.alazab.com.
#
# Example:
# AZ_MAIL_AGENT_IDENTITIES_JSON={"az-agent-finance":{"displayName":"Alazab Finance","email":"finance@alazab.com","replyTo":"finance@alazab.com"}}
